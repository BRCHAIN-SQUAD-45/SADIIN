# =============================================================================
# SADIIN / BRchain Portal — Variáveis de Ambiente (Front-end)
# Copie este arquivo para frontend/.env antes de rodar o projeto.
# =============================================================================

# Modo de dados do front-end: "mock" (dados simulados com MSW) ou "api" (back-end real)
VITE_DATA_MODE=mock

# URL base do back-end SEM o sufixo /api/v1 (o front adiciona sozinho).
# Vazio = mesma origem, usando o proxy do Vite para http://localhost:8000 em desenvolvimento.
VITE_API_URL=

# Timeout das requisições HTTP do front-end (em milissegundos).
# 20 s porque a 1ª consulta de UBS de uma cidade grande demora (~9 s em São Paulo) até entrar no cache.
VITE_REQUEST_TIMEOUT_MS=20000

# Provedor de tiles do mapa interativo (OpenStreetMap)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

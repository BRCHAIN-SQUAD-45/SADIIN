# =============================================================================
# SADIIN / BRchain Portal — Variáveis de Ambiente de Exemplo
# Copie este arquivo para .env e preencha com suas credenciais locais.
# NUNCA faça commit do arquivo .env real no repositório.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. FRONT-END (Vite + React 18)
# -----------------------------------------------------------------------------
# Modo de dados do front-end: "mock" (MSW local) ou "api" (back-end FastAPI real)
VITE_DATA_MODE=mock
# URL base da API REST interna (usada quando VITE_DATA_MODE=api)
VITE_API_URL=http://localhost:8000/api/v1
# Timeout das requisições HTTP do front-end (em milissegundos)
VITE_API_TIMEOUT_MS=8000
# Provedor de tiles do mapa interativo (OpenStreetMap)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# -----------------------------------------------------------------------------
# 2. BACK-END (Python 3.11 + FastAPI + PostgreSQL 15)
# -----------------------------------------------------------------------------
APP_ENV=development
APP_PORT=8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sadiin_db

# -----------------------------------------------------------------------------
# 3. CONECTORES SUS (DATASUS / CNES / e-SUS APS / RNDS FHIR R4)
# -----------------------------------------------------------------------------
DATASUS_CNES_BASE_URL=https://apidadosabertos.saude.gov.br/cnes
DATASUS_TIMEOUT_SECONDS=10
DATASUS_MAX_RETRIES=3

# Credenciais OAuth2 (client_credentials) para ambiente de homologação da RNDS
RNDS_AUTH_URL=https://ehr-auth-hmg.saude.gov.br/api/token
RNDS_FHIR_BASE_URL=https://ehr-services.hmg.saude.gov.br/api/fhir/r4
RNDS_CLIENT_ID=seu_client_id_homologacao_aqui
RNDS_CLIENT_SECRET=seu_client_secret_homologacao_aqui

# -----------------------------------------------------------------------------
# 4. INTELIGÊNCIA ARTIFICIAL / RAG (Back-end)
# -----------------------------------------------------------------------------
# Provedor ativo: "anthropic" | "gemini" | "openai"
AI_PROVIDER=gemini
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Limiar mínimo de confiança semântica para busca de sintomas (0.0 a 1.0)
AI_CONFIDENCE_THRESHOLD=0.85

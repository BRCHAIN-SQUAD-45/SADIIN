# Modo de dados: mock (MSW responde no formato do contrato) | api (back-end real)
VITE_DATA_MODE=mock

# URL base do back-end (sem /api/v1). Vazio = mesma origem (usa o proxy do Vite em dev
# ou o mesmo domínio em produção). Ex.: http://localhost:8000
VITE_API_URL=

# Alvo do proxy de desenvolvimento para /api (evita CORS com o back local)
VITE_DEV_PROXY_TARGET=http://localhost:8000

# Timeout por requisição (ms)
VITE_REQUEST_TIMEOUT_MS=8000

# Tiles do mapa. O tile.openstreetmap.org serve apenas para dev/demo:
# em produção configure outro provedor (MapTiler, Stadia, self-hosted...).
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors

# Município padrão (código IBGE, 7 dígitos) — São Paulo
VITE_DEFAULT_CITY_IBGE=3550308
